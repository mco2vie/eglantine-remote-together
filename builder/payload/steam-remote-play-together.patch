+namespace RemotePlayTogether {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr int TickIntervalMs = 16;
+constexpr int TicksPerDeviceScan = 30;
+constexpr int GuestLinkTimeoutMs = 10000;
+// A virtual gamepad that was there this long before the first guest joined belongs to the host
+constexpr auto HostPadGracePeriod = std::chrono::seconds{5};
+// Player 1 is the host, guests get Player 2 to Player 8
+constexpr std::size_t HostPlayer = 0;
+constexpr std::size_t FirstGuestPlayer = 1;
+constexpr std::size_t LastGuestPlayer = 7;
+
+constexpr std::size_t NumButtons = Settings::NativeButton::NumButtons;
+constexpr std::size_t NumSticks = Settings::NativeAnalog::NumAnalogs;
+constexpr std::size_t NumMotions = Settings::NativeMotion::NumMotions;
+
+// STEAM_REMOTE_PLAY_APPID, used when nothing else picks an App ID
+constexpr u32 DefaultAppId{EGLANTINE_STEAM_APPID};
+
+// Where the App ID Eglantine asks Steam for comes from, strongest first
+enum class AppIdSource {
+    Environment, // Steam started Eglantine, or nx2_switches.txt sets SteamAppId
+    Chosen,      // Multiplayer > Change Steam App ID
+    AppIdFile,   // steam_appid.txt in the working directory, which the Steam API reads itself
+    Default,
+};
+
+bool steam_ready = false;
+std::string steam_error;
+AppIdSource app_id_source = AppIdSource::Default;
+// 0 when it couldn't be read
+u32 requested_app_id = 0;
+
+bool HasEnvironmentValue(const char* name) {
+    const char* value = std::getenv(name);
+    return value != nullptr && value[0] != '\0' && std::strcmp(value, "0") != 0;
+}
+
+void SetEnvironmentValue(const char* name, const char* value) {
+#ifdef _WIN32
+    // SDL and the Steam client read the process environment block, the CRT keeps its own copy
+    SetEnvironmentVariableA(name, value);
+    _putenv_s(name, value);
+#else
+    setenv(name, value, 1);
+#endif
+}
+
+// Reads an App ID number, optionally followed by whitespace and a label
+std::optional<u32> ParseAppId(std::string_view text) {
+    const auto is_space = [](char c) { return std::isspace(static_cast<unsigned char>(c)) != 0; };
+    while (!text.empty() && is_space(text.front())) {
+        text.remove_prefix(1);
+    }
+    const char* const end = text.data() + text.size();
+    u32 app_id = 0;
+    const auto [rest, ec] = std::from_chars(text.data(), end, app_id);
+    if (ec != std::errc{} || app_id == 0 || (rest != end && !is_space(*rest))) {
+        return std::nullopt;
+    }
+    return app_id;
+}
+
+std::optional<u32> ReadAppIdFile(const std::filesystem::path& path) {
+    std::ifstream file{path};
+    std::string line;
+    if (!std::getline(file, line)) {
+        return std::nullopt;
+    }
+    // Notepad can start the file with a UTF-8 byte order mark
+    if (line.starts_with("\xEF\xBB\xBF")) {
+        line.erase(0, 3);
+    }
+    return ParseAppId(line);
+}
+
+// The App ID picked in the menu is kept next to the user's nx2_switches.txt
+std::filesystem::path ChosenAppIdPath() {
+#ifdef _WIN32
+    const auto config_dir = Common::FS::GetAppDataRoamingDirectory() / EDEN_DIR;
+#else
+    const auto config_dir = Common::FS::GetDataDirectory("XDG_CONFIG_HOME") / EDEN_DIR;
+#endif
+    return config_dir / "steam_remote_play_appid.txt";
+}
+
+bool SaveChosenAppId(u32 app_id) {
+    const auto path = ChosenAppIdPath();
+    std::error_code ec;
+    std::filesystem::create_directories(path.parent_path(), ec);
+    std::ofstream file{path, std::ios::trunc};
+    file << app_id << '\n';
+    file.close();
+    return !file.fail();
+}
+
+void RequestAppId(u32 app_id) {
+    const auto text = std::to_string(app_id);
+    SetEnvironmentValue("SteamAppId", text.c_str());
+    SetEnvironmentValue("SteamGameId", text.c_str());
+    requested_app_id = app_id;
+}
+
+// The App ID Eglantine runs as, or the one Steam refused. 0 when unknown.
+u32 CurrentAppId() {
+    return steam_ready ? SteamUtils()->GetAppID() : requested_app_id;
+}
+
+const char* AppIdSourceName() {
+    switch (app_id_source) {
+    case AppIdSource::Environment:
+        return "SteamAppId environment variable";
+    case AppIdSource::Chosen:
+        return "chosen in the Multiplayer menu";
+    case AppIdSource::AppIdFile:
+        return "steam_appid.txt";
+    case AppIdSource::Default:
+        return "build default";
+    }
+    return "";
+}
+
+// Steam gives every Remote Play guest controller to the game as one of these
+bool IsSteamVirtualGamepad(const Common::ParamPackage& device) {
+    if (device.Get("engine", "") != "sdl" || device.Has("guid2")) {
+        return false;
+    }
+    // SDL GUIDs hold the USB vendor in bytes 4-5, the product in 8-9 and the version in 12-13
+    const Common::UUID guid{device.Get("guid", "")};
+    const auto read_u16 = [&guid](std::size_t offset) {
+        return static_cast<u16>(guid.uuid[offset] | (guid.uuid[offset + 1] << 8));
+    };
+#ifdef __APPLE__
+    return read_u16(4) == 0x045E && read_u16(8) == 0x028E && read_u16(12) == 0;
+#else
+    return read_u16(4) == 0x28DE && read_u16(8) == 0x11FF;
+#endif
+}
+
+std::string DeviceKey(const Common::ParamPackage& device) {
+    return fmt::format("{}:{}", device.Get("guid", ""), device.Get("port", 0));
+}
+
+bool UsesDevice(const Core::HID::EmulatedController& controller,
+                const Common::ParamPackage& device) {
+    const auto mapped = controller.GetMappedDevices();
+    return std::any_of(mapped.begin(), mapped.end(), [&device](const Common::ParamPackage& used) {
+        return used.Get("engine", "") == device.Get("engine", "") &&
+               used.Get("guid", "") == device.Get("guid", "") &&
+               used.Get("port", 0) == device.Get("port", 0);
+    });
+}
+
+struct SavedPlayer {
+    std::array<Common::ParamPackage, NumButtons> buttons;
+    std::array<Common::ParamPackage, NumSticks> sticks;
+    std::array<Common::ParamPackage, NumMotions> motions;
+    Core::HID::NpadStyleIndex style{};
+    bool connected{};
+};
+
+SavedPlayer SavePlayer(const Core::HID::EmulatedController& controller) {
+    SavedPlayer saved;
+    for (std::size_t i = 0; i < NumButtons; ++i) {
+        saved.buttons[i] = controller.GetButtonParam(i);
+    }
+    for (std::size_t i = 0; i < NumSticks; ++i) {
+        saved.sticks[i] = controller.GetStickParam(i);
+    }
+    for (std::size_t i = 0; i < NumMotions; ++i) {
+        saved.motions[i] = controller.GetMotionParam(i);
+    }
+    saved.style = controller.GetNpadStyleIndex();
+    saved.connected = controller.IsConnected();
+    return saved;
+}
+
+void LoadPlayer(Core::HID::EmulatedController& controller, const SavedPlayer& saved) {
+    for (std::size_t i = 0; i < NumButtons; ++i) {
+        controller.SetButtonParam(i, saved.buttons[i]);
+    }
+    for (std::size_t i = 0; i < NumSticks; ++i) {
+        controller.SetStickParam(i, saved.sticks[i]);
+    }
+    for (std::size_t i = 0; i < NumMotions; ++i) {
+        controller.SetMotionParam(i, saved.motions[i]);
+    }
+    // Player 1 keeps its type, so it stays plugged in while it gets its own controller back
+    if (controller.GetNpadStyleIndex() != saved.style ||
+        controller.IsConnected() != saved.connected) {
+        controller.Disconnect();
+        controller.SetNpadStyleIndex(saved.style);
+        if (saved.connected) {
+            controller.Connect();
+        }
+    }
+    controller.SaveCurrentConfig();
+}
+
+// Maps every control to the device, like picking it in the controls dialog
+void MapDevice(Core::HID::EmulatedController& controller, const Common::ParamPackage& device,
+               InputCommon::InputSubsystem& input_subsystem) {
+    for (std::size_t i = 0; i < NumButtons; ++i) {
+        controller.SetButtonParam(i, {});
+    }
+    for (std::size_t i = 0; i < NumSticks; ++i) {
+        controller.SetStickParam(i, {});
+    }
+    for (std::size_t i = 0; i < NumMotions; ++i) {
+        controller.SetMotionParam(i, {});
+    }
+    for (const auto& [button, param] : input_subsystem.GetButtonMappingForDevice(device)) {
+        controller.SetButtonParam(static_cast<std::size_t>(button), param);
+    }
+    for (const auto& [stick, param] : input_subsystem.GetAnalogMappingForDevice(device)) {
+        controller.SetStickParam(static_cast<std::size_t>(stick), param);
+    }
+    for (const auto& [motion, param] : input_subsystem.GetMotionMappingForDevice(device)) {
+        controller.SetMotionParam(static_cast<std::size_t>(motion), param);
+    }
+}
+
+// Maps the device, then plugs the player in
+void BindDevice(Core::HID::EmulatedController& controller, const Common::ParamPackage& device,
+                InputCommon::InputSubsystem& input_subsystem) {
+    MapDevice(controller, device, input_subsystem);
+    controller.SetNpadStyleIndex(Core::HID::NpadStyleIndex::Fullkey);
+    controller.Connect();
+    if (!controller.IsConnected()) {
+        // The running game doesn't take Pro Controllers
+        controller.SetNpadStyleIndex(Core::HID::NpadStyleIndex::JoyconDual);
+        controller.Connect();
+    }
+    controller.SaveCurrentConfig();
+}
+
+QString RefusedMessage() {
+    return QObject::tr("Steam refused. It does this when the Steam overlay is turned off, or when "
+                       "the App ID Eglantine runs as (%1) isn't set up for Remote Play Together.")
+        .arg(SteamUtils()->GetAppID());
+}
+
+QString NoGuestLinkMessage() {
+    return QObject::tr("Steam didn't create a guest link. Steam can make one too: press Shift+Tab, "
+                       "open your friends list and click Invite Anyone to Play.");
+}
+
+// The host streaming to their own Steam Link or computer. Guests from an invite link have no Steam
+// account, so their session can have the host's Steam ID too.
+bool IsHostSession(RemotePlaySessionID_t session) {
+    auto* const remote_play = SteamRemotePlay();
+    if (remote_play->BSessionRemotePlayTogether(session) ||
+        remote_play->GetSessionGuestID(session) != 0) {
+        return false;
+    }
+    return remote_play->GetSessionSteamID(session) == SteamUser()->GetSteamID();
+}
+
+} // Anonymous namespace
+
+void Initialize() {
+    std::error_code ec;
+    if (HasEnvironmentValue("SteamAppId")) {
+        const std::string app_id = std::getenv("SteamAppId");
+        app_id_source = AppIdSource::Environment;
+        requested_app_id = ParseAppId(app_id).value_or(0);
+        if (!HasEnvironmentValue("SteamGameId")) {
+            SetEnvironmentValue("SteamGameId", app_id.c_str());
+        }
+    } else if (const auto chosen = ReadAppIdFile(ChosenAppIdPath())) {
+        app_id_source = AppIdSource::Chosen;
+        RequestAppId(*chosen);
+    } else if (std::filesystem::exists("steam_appid.txt", ec)) {
+        app_id_source = AppIdSource::AppIdFile;
+        requested_app_id = ReadAppIdFile("steam_appid.txt").value_or(0);
+    } else {
+        app_id_source = AppIdSource::Default;
+        RequestAppId(DefaultAppId);
+    }
+
+    SteamErrMsg error{};
+    if (SteamAPI_InitEx(&error) != k_ESteamAPIInitResult_OK) {
+        steam_error = error;
+        return;
+    }
+    if (SteamRemotePlay() == nullptr) {
+        steam_error = "the Steam client has no Remote Play interface";
+        SteamAPI_Shutdown();
+        return;
+    }
+    steam_ready = true;
+
+    // SDL ignores Steam's virtual gamepads unless this is set, which Steam only does for games it
+    // starts itself. Guest controllers only exist as virtual gamepads.
+    SetEnvironmentValue("SDL_GAMECONTROLLER_ALLOW_STEAM_VIRTUAL_GAMEPAD", "1");
+}
+
+void Shutdown() {
+    if (steam_ready) {
+        SteamAPI_Shutdown();
+        steam_ready = false;
+    }
+}
+
+struct Manager::Impl {
+    struct Guest {
+        RemotePlaySessionID_t session{};
+        std::size_t keyboard_slot{};
+        std::string name;
+    };
+
+    // A virtual gamepad given to a player, and the controls that player had before
+    struct AssignedPad {
+        std::string key;
+        Common::ParamPackage device;
+        std::size_t player{};
+        SavedPlayer previous;
+    };
+
+    Impl(QWidget* parent_, InputCommon::InputSubsystem& input_subsystem_,
+         Core::HID::HIDCore& hid_core_);
+    ~Impl();
+
+    void Tick();
+    void SyncSessions();
+    void AddGuest(RemotePlaySessionID_t session);
+    void RemoveGuest(RemotePlaySessionID_t session);
+    std::string GetGuestName(RemotePlaySessionID_t session, std::size_t slot) const;
+    void ReadGuestInput();
+    void UpdateGuestPads();
+    bool IsHostPad(const std::string& key) const;
+    bool IsAssigned(const std::string& key) const;
+    bool IsUsedByConnectedPlayer(const Common::ParamPackage& device) const;
+    void UpdateHostPad(const std::vector<Common::ParamPackage>& devices,
+                       const std::vector<Common::ParamPackage>& pads);
+    void AssignPad(const Common::ParamPackage& device, const std::string& key);
+    bool RestorePad(const AssignedPad& pad);
+    void UpdateStatus();
+    void ShowInviteOverlay();
+    void CreateGuestLink();
+    void ChooseAppId();
+
+    void OnSessionConnected(SteamRemotePlaySessionConnected_t* event);
+    void OnSessionDisconnected(SteamRemotePlaySessionDisconnected_t* event);
+    void OnGuestInvite(SteamRemotePlayTogetherGuestInvite_t* event);
+
+    QWidget* parent;
+    InputCommon::InputSubsystem& input_subsystem;
+    Core::HID::HIDCore& hid_core;
+    QObject context;
+    QTimer timer;
+    QLabel* status_label;
+    bool direct_input{};
+    bool link_requested{};
+    int ticks_until_scan{};
+
+    std::vector<Guest> guests;
+    std::optional<Clock::time_point> guests_since;
+    std::unordered_map<std::string, Clock::time_point> first_seen;
+    std::vector<AssignedPad> assigned_pads;
+    std::vector<std::string> refused_pads;
+    std::vector<std::string> reported_pads;
+
+    // These register with Steam when constructed, so they only exist while Steam is up
+    std::optional<CCallback<Impl, SteamRemotePlaySessionConnected_t>> connected_callback;
+    std::optional<CCallback<Impl, SteamRemotePlaySessionDisconnected_t>> disconnected_callback;
+    std::optional<CCallback<Impl, SteamRemotePlayTogetherGuestInvite_t>> invite_callback;
+};
+
+Manager::Impl::Impl(QWidget* parent_, InputCommon::InputSubsystem& input_subsystem_,
+                    Core::HID::HIDCore& hid_core_)
+    : parent{parent_}, input_subsystem{input_subsystem_}, hid_core{hid_core_},
+      status_label{new QLabel(parent_)} {
+    status_label->setContentsMargins(4, 0, 4, 0);
+    status_label->setVisible(steam_ready);
+
+    if (!steam_ready) {
+        LOG_WARNING(Frontend, "Steam Remote Play Together is unavailable with App ID {} ({}): {}",
+                    requested_app_id, AppIdSourceName(), steam_error);
+        return;
+    }
+    const u32 app_id = SteamUtils()->GetAppID();
+    LOG_INFO(Frontend, "Connected to Steam, running as App ID {} ({})", app_id, AppIdSourceName());
+    if (requested_app_id != 0 && app_id != requested_app_id) {
+        LOG_WARNING(Frontend, "Steam runs Eglantine as App ID {} instead of {}", app_id,
+                    requested_app_id);
+    }
+
+    // Keeps guest keyboards out of the host's keyboard and hotkeys
+    direct_input = SteamRemotePlay()->BEnableRemotePlayTogetherDirectInput();
+    if (!direct_input) {
+        LOG_WARNING(Frontend, "Steam merges guest keyboards with the local keyboard");
+    }
+
+    connected_callback.emplace(this, &Impl::OnSessionConnected);
+    disconnected_callback.emplace(this, &Impl::OnSessionDisconnected);
+    invite_callback.emplace(this, &Impl::OnGuestInvite);
+
+    QObject::connect(&timer, &QTimer::timeout, &context, [this] { Tick(); });
+    timer.start(TickIntervalMs);
+    UpdateStatus();
+}
+
+Manager::Impl::~Impl() {
+    timer.stop();
+    if (direct_input) {
+        SteamRemotePlay()->DisableRemotePlayTogetherDirectInput();
+    }
+}
+
+void Manager::Impl::Tick() {
+    SteamAPI_RunCallbacks();
+    ReadGuestInput();
+    if (--ticks_until_scan <= 0) {
+        ticks_until_scan = TicksPerDeviceScan;
+        SyncSessions();
+        UpdateGuestPads();
+    }
+}
+
+// Callbacks can be missed, so the session list from Steam is the reference
+void Manager::Impl::SyncSessions() {
+    auto* const remote_play = SteamRemotePlay();
+    std::vector<RemotePlaySessionID_t> sessions;
+    const uint32 count = remote_play->GetSessionCount();
+    for (uint32 i = 0; i < count; ++i) {
+        const RemotePlaySessionID_t session = remote_play->GetSessionID(static_cast<int>(i));
+        if (session != 0) {
+            sessions.push_back(session);
+        }
+    }
+
+    std::vector<RemotePlaySessionID_t> gone;
+    for (const auto& guest : guests) {
+        if (std::find(sessions.begin(), sessions.end(), guest.session) == sessions.end()) {
+            gone.push_back(guest.session);
+        }
+    }
+    for (const auto session : gone) {
+        RemoveGuest(session);
+    }
+    for (const auto session : sessions) {
+        AddGuest(session);
+    }
+}
+
+void Manager::Impl::AddGuest(RemotePlaySessionID_t session) {
+    const auto known = std::any_of(guests.begin(), guests.end(), [session](const Guest& guest) {
+        return guest.session == session;
+    });
+    if (session == 0 || known) {
+        return;
+    }
+
+    if (IsHostSession(session)) {
+        return;
+    }
+
+    auto* const remote_play = SteamRemotePlay();
+    std::size_t slot = 0;
+    while (slot < InputCommon::RemotePlayKeyboard::MaxGuests &&
+           std::any_of(
+               guests.begin(), guests.end(),
+               [slot](const Guest& guest) { return guest.keyboard_slot == slot; })) {
+        ++slot;
+    }
+    if (slot == InputCommon::RemotePlayKeyboard::MaxGuests) {
+        LOG_WARNING(Frontend, "Remote Play Together: too many guests, ignoring session {}",
+                    session);
+        return;
+    }
+
+    Guest guest{session, slot, GetGuestName(session, slot)};
+    if (auto* const keyboard = input_subsystem.GetRemotePlayKeyboard()) {
+        keyboard->ConnectGuest(slot, guest.name);
+    }
+    if (direct_input) {
+        // Guest mice aren't used, so don't draw their cursors
+        remote_play->SetMouseVisibility(session, false);
+    }
+    if (guests.empty()) {
+        guests_since = Clock::now();
+    }
+    LOG_INFO(Frontend, "Remote Play Together: {} joined", guest.name);
+    guests.push_back(std::move(guest));
+    UpdateStatus();
+}
+
+void Manager::Impl::RemoveGuest(RemotePlaySessionID_t session) {
+    const auto it = std::find_if(guests.begin(), guests.end(), [session](const Guest& guest) {
+        return guest.session == session;
+    });
+    if (it == guests.end()) {
+        return;
+    }
+    if (auto* const keyboard = input_subsystem.GetRemotePlayKeyboard()) {
+        keyboard->DisconnectGuest(it->keyboard_slot);
+    }
+    LOG_INFO(Frontend, "Remote Play Together: {} left", it->name);
+    guests.erase(it);
+    if (guests.empty()) {
+        guests_since.reset();
+    }
+    UpdateStatus();
+}
+
+std::string Manager::Impl::GetGuestName(RemotePlaySessionID_t session, std::size_t slot) const {
+    auto* const remote_play = SteamRemotePlay();
+    const CSteamID steam_id = remote_play->GetSessionSteamID(session);
+    // Guests from an invite link have no Steam account, use their device name
+    if (steam_id.BIndividualAccount() && steam_id != SteamUser()->GetSteamID()) {
+        const char* const name = SteamFriends()->GetFriendPersonaName(steam_id);
+        if (name != nullptr && name[0] != '\0' && std::strcmp(name, "[unknown]") != 0) {
+            return name;
+        }
+    }
+    const char* const device = remote_play->GetSessionClientName(session);
+    if (device != nullptr && device[0] != '\0') {
+        return device;
+    }
+    return fmt::format("Guest {}", slot + 1);
+}
+
+void Manager::Impl::ReadGuestInput() {
+    if (!direct_input) {
+        return;
+    }
+    auto* const keyboard = input_subsystem.GetRemotePlayKeyboard();
+    auto* const remote_play = SteamRemotePlay();
+    std::array<RemotePlayInput_t, 32> events{};
+    uint32 count = 0;
+    do {
+        count = remote_play->GetInput(events.data(), static_cast<uint32>(events.size()));
+        for (uint32 i = 0; i < count; ++i) {
+            const RemotePlayInput_t& event = events[i];
+            // Guest mice aren't mapped to anything
+            if (event.m_eType != k_ERemotePlayInputKeyDown &&
+                event.m_eType != k_ERemotePlayInputKeyUp) {
+                continue;
+            }
+            const auto guest =
+                std::find_if(guests.begin(), guests.end(), [&event](const Guest& entry) {
+                    return entry.session == event.m_unSessionID;
+                });
+            if (guest == guests.end() || keyboard == nullptr) {
+                continue;
+            }
+            keyboard->SetKey(guest->keyboard_slot, event.data.m_Key.m_eScancode,
+                             event.m_eType == k_ERemotePlayInputKeyDown);
+        }
+    } while (count == events.size());
+}
+
+void Manager::Impl::UpdateGuestPads() {
+    const auto now = Clock::now();
+    const auto devices = input_subsystem.GetInputDevices();
+    std::vector<Common::ParamPackage> pads;
+    for (const auto& device : devices) {
+        if (IsSteamVirtualGamepad(device)) {
+            pads.push_back(device);
+        }
+    }
+    const auto is_present = [&pads](const std::string& key) {
+        return std::any_of(pads.begin(), pads.end(), [&key](const Common::ParamPackage& pad) {
+            return DeviceKey(pad) == key;
+        });
+    };
+
+    // A virtual gamepad that went away means its guest left or Steam let go of the host's
+    // controller, so the player gets its controls back
+    const auto restored = std::erase_if(assigned_pads, [&](const AssignedPad& pad) {
+        return !is_present(pad.key) && RestorePad(pad);
+    });
+    std::erase_if(first_seen, [&](const auto& entry) {
+        if (is_present(entry.first)) {
+            return false;
+        }
+        LOG_INFO(Frontend, "Remote Play Together: Steam virtual gamepad {} went away", entry.first);
+        return true;
+    });
+    std::erase_if(refused_pads, [&](const std::string& key) { return !is_present(key); });
+    std::erase_if(reported_pads, [&](const std::string& key) { return !is_present(key); });
+    for (const auto& pad : pads) {
+        if (first_seen.try_emplace(DeviceKey(pad), now).second) {
+            LOG_INFO(Frontend,
+                     "Remote Play Together: Steam virtual gamepad {} ({}) appeared, {} guest(s)",
+                     pad.Get("display", ""), DeviceKey(pad), guests.size());
+        }
+    }
+    if (restored != 0) {
+        UpdateStatus();
+    }
+
+    UpdateHostPad(devices, pads);
+
+    if (!guests_since) {
+        return;
+    }
+    for (const auto& pad : pads) {
+        const auto key = DeviceKey(pad);
+        const auto refused =
+            std::find(refused_pads.begin(), refused_pads.end(), key) != refused_pads.end();
+        if (IsHostPad(key) || IsAssigned(key) || refused || IsUsedByConnectedPlayer(pad)) {
+            continue;
+        }
+        AssignPad(pad, key);
+    }
+}
+
+// A virtual gamepad that was there before the first guest joined is the host's own controller
+bool Manager::Impl::IsHostPad(const std::string& key) const {
+    return !guests_since || first_seen.at(key) + HostPadGracePeriod < *guests_since;
+}
+
+bool Manager::Impl::IsAssigned(const std::string& key) const {
+    return std::any_of(assigned_pads.begin(), assigned_pads.end(),
+                       [&key](const AssignedPad& pad) { return pad.key == key; });
+}
+
+bool Manager::Impl::IsUsedByConnectedPlayer(const Common::ParamPackage& device) const {
+    for (std::size_t index = 0; index < Core::HID::HIDCore::available_controllers; ++index) {
+        const auto* const controller = hid_core.GetEmulatedControllerByIndex(index);
+        if (controller != nullptr && controller->IsConnected() && UsesDevice(*controller, device)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Steam Input can take over the host's own controller: the real one disappears and a virtual
+// gamepad shows up instead. Player 1 then uses the virtual gamepad until Steam lets go.
+void Manager::Impl::UpdateHostPad(const std::vector<Common::ParamPackage>& devices,
+                                  const std::vector<Common::ParamPackage>& pads) {
+    auto* const controller = hid_core.GetEmulatedControllerByIndex(HostPlayer);
+    if (controller == nullptr || !controller->IsConnected() || controller->IsConfiguring()) {
+        return;
+    }
+    const auto has_pad =
+        std::any_of(assigned_pads.begin(), assigned_pads.end(),
+                    [](const AssignedPad& pad) { return pad.player == HostPlayer; });
+    if (has_pad) {
+        return;
+    }
+
+    // Only when every device Player 1 is mapped to is a controller that went away
+    const auto is_gone = [&devices](const Common::ParamPackage& used) {
+        return used.Get("engine", "") == "sdl" &&
+               std::none_of(devices.begin(), devices.end(),
+                            [&used](const Common::ParamPackage& device) {
+                                return device.Get("engine", "") == "sdl" &&
+                                       device.Get("guid", "") == used.Get("guid", "") &&
+                                       device.Get("port", 0) == used.Get("port", 0);
+                            });
+    };
+    const auto mapped = controller->GetMappedDevices();
+    if (mapped.empty() || !std::all_of(mapped.begin(), mapped.end(), is_gone)) {
+        return;
+    }
+
+    for (const auto& pad : pads) {
+        const auto key = DeviceKey(pad);
+        if (!IsHostPad(key) || IsAssigned(key) || IsUsedByConnectedPlayer(pad)) {
+            continue;
+        }
+        AssignedPad entry{key, pad, HostPlayer, SavePlayer(*controller)};
+        MapDevice(*controller, pad, input_subsystem);
+        controller->SaveCurrentConfig();
+        LOG_INFO(
+            Frontend,
+            "Remote Play Together: Steam took over Player 1's controller, Player 1 now uses {}",
+            pad.Get("display", ""));
+        assigned_pads.push_back(std::move(entry));
+        UpdateStatus();
+        return;
+    }
+}
+
+void Manager::Impl::AssignPad(const Common::ParamPackage& device, const std::string& key) {
+    bool waiting = false;
+    for (std::size_t index = FirstGuestPlayer; index <= LastGuestPlayer; ++index) {
+        auto* const controller = hid_core.GetEmulatedControllerByIndex(index);
+        if (controller == nullptr || controller->IsConnected()) {
+            continue;
+        }
+        if (controller->IsConfiguring()) {
+            // The controls dialog is open, try again once it closes
+            waiting = true;
+            continue;
+        }
+
+        AssignedPad pad{key, device, index, SavePlayer(*controller)};
+        BindDevice(*controller, device, input_subsystem);
+        if (!controller->IsConnected()) {
+            LoadPlayer(*controller, pad.previous);
+            refused_pads.push_back(key);
+            LOG_WARNING(Frontend,
+                        "Remote Play Together: the game refused a controller as Player {}",
+                        index + 1);
+            return;
+        }
+        LOG_INFO(Frontend, "Remote Play Together: {} is now Player {}", device.Get("display", ""),
+                 index + 1);
+        assigned_pads.push_back(std::move(pad));
+        UpdateStatus();
+        return;
+    }
+
+    if (!waiting &&
+        std::find(reported_pads.begin(), reported_pads.end(), key) == reported_pads.end()) {
+        reported_pads.push_back(key);
+        LOG_WARNING(Frontend, "Remote Play Together: no free player for {}",
+                    device.Get("display", ""));
+    }
+}
+
+bool Manager::Impl::RestorePad(const AssignedPad& pad) {
+    auto* const controller = hid_core.GetEmulatedControllerByIndex(pad.player);
+    if (controller == nullptr) {
+        return true;
+    }
+    if (controller->IsConfiguring()) {
+        return false;
+    }
+    // Leave the player alone if it was remapped since
+    if (UsesDevice(*controller, pad.device)) {
+        LoadPlayer(*controller, pad.previous);
+        LOG_INFO(Frontend, "Remote Play Together: Player {} has its own controls back",
+                 pad.player + 1);
+    }
+    return true;
+}
+
+void Manager::Impl::UpdateStatus() {
+    if (guests.empty()) {
+        status_label->setText(QObject::tr("Remote Play: no guests"));
+    } else {
+        status_label->setText(
+            QObject::tr("Remote Play: %n guest(s)", nullptr, static_cast<int>(guests.size())));
+    }
+
+    QStringList lines;
+    for (const auto& guest : guests) {
+        lines << QString::fromStdString(guest.name);
+    }
+    for (const auto& pad : assigned_pads) {
+        lines << QObject::tr("Player %1: %2")
+                     .arg(static_cast<int>(pad.player + 1))
+                     .arg(QString::fromStdString(pad.device.Get("display", "")));
+    }
+    status_label->setToolTip(lines.isEmpty()
+                                 ? QObject::tr("Invite friends from the Multiplayer menu")
+                                 : lines.join(QLatin1Char('\n')));
+}
+
+void Manager::Impl::ShowInviteOverlay() {
+    if (!SteamRemotePlay()->ShowRemotePlayTogetherUI()) {
+        QMessageBox::warning(parent, QObject::tr("Remote Play Together"), RefusedMessage());
+    }
+}
+
+void Manager::Impl::CreateGuestLink() {
+    // An empty Steam ID asks for a link instead of an invite, OnGuestInvite receives it
+    if (!SteamRemotePlay()->BSendRemotePlayTogetherInvite(CSteamID())) {
+        LOG_WARNING(Frontend, "Remote Play Together: Steam refused to create a guest link");
+        QMessageBox::warning(parent, QObject::tr("Remote Play Together"), NoGuestLinkMessage());
+        return;
+    }
+    LOG_INFO(Frontend, "Remote Play Together: asked Steam for a guest link");
+    link_requested = true;
+    QTimer::singleShot(GuestLinkTimeoutMs, &context, [this] {
+        if (!link_requested) {
+            return;
+        }
+        link_requested = false;
+        LOG_WARNING(Frontend, "Remote Play Together: Steam sent no guest link");
+        QMessageBox::warning(parent, QObject::tr("Remote Play Together"), NoGuestLinkMessage());
+    });
+}
+
+void Manager::Impl::ChooseAppId() {
+    const u32 current = CurrentAppId();
+    const auto chosen = ReadAppIdFile(ChosenAppIdPath());
+    const u32 next = chosen.value_or(current != 0 ? current : DefaultAppId);
+
+    QString label = QObject::tr("Enter a Steam App ID that you own or that its owner has "
+                                "explicitly authorized you to use. It must be configured for "
+                                "Remote Play Together. This feature does not grant permission "
+                                "to use another game's App ID.");
+    if (current != 0) {
+        label +=
+            QStringLiteral("\n\n") + QObject::tr("Eglantine runs as App ID %1 now.").arg(current);
+    }
+    if (!steam_ready) {
+        label += QStringLiteral("\n\n") +
+                 QObject::tr("Steam didn't connect: %1").arg(QString::fromStdString(steam_error));
+    }
+
+    const QString title = QObject::tr("Steam App ID");
+    bool ok = false;
+    const QString text =
+        QInputDialog::getText(parent, title, label, QLineEdit::Normal, QString::number(next), &ok);
+    if (!ok) {
+        return;
+    }
+    const auto app_id = ParseAppId(text.toStdString());
+    if (!app_id) {
+        QMessageBox::warning(parent, title,
+                             QObject::tr("\"%1\" isn't a Steam App ID. App IDs are positive "
+                                         "whole numbers.")
+                                 .arg(text.trimmed()));
+        return;
+    }
+    if (!SaveChosenAppId(*app_id)) {
+        QMessageBox::warning(
+            parent, title,
+            QObject::tr("Eglantine couldn't save the App ID in %1.")
+                .arg(QString::fromStdString(Common::FS::PathToUTF8String(ChosenAppIdPath()))));
+        return;
+    }
+    LOG_INFO(Frontend, "Remote Play Together: App ID {} chosen", *app_id);
+
+    QString message =
+        *app_id == current
+            ? QObject::tr("Eglantine runs as App ID %1.").arg(*app_id)
+            : QObject::tr("Eglantine runs as App ID %1 from the next start. Close Eglantine and "
+                          "start it again.")
+                  .arg(*app_id);
+    if (app_id_source == AppIdSource::Environment) {
+        message += QStringLiteral("\n\n") +
+                   QObject::tr("For now the SteamAppId environment variable decides, because "
+                               "Steam started Eglantine or nx2_switches.txt sets it. Your choice "
+                               "applies once it's gone.");
+    }
+    QMessageBox::information(parent, title, message);
+}
+
+void Manager::Impl::OnSessionConnected(SteamRemotePlaySessionConnected_t* event) {
+    const auto session = event->m_unSessionID;
+    auto* const remote_play = SteamRemotePlay();
+    LOG_INFO(Frontend,
+             "Remote Play Together: session {} connected, invited: {}, guest ID: {}, host's "
+             "account: {}",
+             session, remote_play->BSessionRemotePlayTogether(session),
+             remote_play->GetSessionGuestID(session),
+             remote_play->GetSessionSteamID(session) == SteamUser()->GetSteamID());
+    AddGuest(session);
+}
+
+void Manager::Impl::OnSessionDisconnected(SteamRemotePlaySessionDisconnected_t* event) {
+    RemoveGuest(event->m_unSessionID);
+}
+
+void Manager::Impl::OnGuestInvite(SteamRemotePlayTogetherGuestInvite_t* event) {
+    link_requested = false;
+    const QString url = QString::fromUtf8(
+        event->m_szConnectURL,
+        static_cast<qsizetype>(strnlen(event->m_szConnectURL, sizeof(event->m_szConnectURL))));
+    if (url.isEmpty()) {
+        LOG_WARNING(Frontend, "Remote Play Together: Steam sent an empty guest link");
+        QTimer::singleShot(0, &context, [this] {
+            QMessageBox::warning(parent, QObject::tr("Remote Play Together"), NoGuestLinkMessage());
+        });
+        return;
+    }
+    LOG_INFO(Frontend, "Remote Play Together: got a guest link from Steam");
+    QGuiApplication::clipboard()->setText(url);
+    // Not from inside the Steam callback, the dialog runs its own event loop
+    QTimer::singleShot(0, &context, [this, url] {
+        QMessageBox::information(
+            parent, QObject::tr("Remote Play Together"),
+            QObject::tr("The guest link is on your clipboard. One link lets one person join, from "
+                        "Steam or the Steam Link app:\n\n%1")
+                .arg(url));
+    });
+}
+
+Manager::Manager(QWidget* parent, InputCommon::InputSubsystem& input_subsystem,
+                 Core::HID::HIDCore& hid_core)
+    : impl{std::make_unique<Impl>(parent, input_subsystem, hid_core)} {}
+
+Manager::~Manager() = default;
+
+void Manager::AddMenuActions(QMenu* menu) {
+    menu->addSeparator();
+    if (steam_ready) {
+        auto* const invite =
+            menu->addAction(QObject::tr("Invite Friends to Remote Play Together..."));
+        QObject::connect(invite, &QAction::triggered, &impl->context,
+                         [this] { impl->ShowInviteOverlay(); });
+        auto* const link = menu->addAction(QObject::tr("Copy Remote Play Guest Link"));
+        QObject::connect(link, &QAction::triggered, &impl->context,
+                         [this] { impl->CreateGuestLink(); });
+    } else {
+        menu->addAction(QObject::tr("Remote Play Together (Steam not connected)"))
+            ->setEnabled(false);
+    }
+
+    // Also there without Steam, which refuses App IDs that aren't in the Steam library
+    const u32 app_id = CurrentAppId();
+    auto* const choose =
+        menu->addAction(app_id == 0 ? QObject::tr("Change Steam App ID...")
+                                    : QObject::tr("Change Steam App ID (now %1)...").arg(app_id));
+    QObject::connect(choose, &QAction::triggered, &impl->context, [this] { impl->ChooseAppId(); });
+}
+
+QLabel* Manager::GetStatusLabel() const {
+    return impl->status_label;
+}
+
+bool Manager::Close() {
+    impl->timer.stop();
+    bool changed = false;
+    for (const auto& pad : impl->assigned_pads) {
+        auto* const controller = impl->hid_core.GetEmulatedControllerByIndex(pad.player);
+        if (controller != nullptr && UsesDevice(*controller, pad.device)) {
+            LoadPlayer(*controller, pad.previous);
+            changed = true;
+        }
+    }
+    impl->assigned_pads.clear();
+    return changed;
+}
+
