+#pragma once
+
+#include <memory>
+
+class QLabel;
+class QMenu;
+class QWidget;
+
+namespace Core::HID {
+class HIDCore;
+}
+
+namespace InputCommon {
+class InputSubsystem;
+}
+
+// Steam Remote Play Together. Not named SteamRemotePlay, which is the Steamworks accessor.
+namespace RemotePlayTogether {
+
+/**
+ * Connects to the running Steam client. Call it before any graphics device exists, so the Steam
+ * overlay can hook it, and before input starts, so SDL accepts the virtual gamepads Steam creates
+ * for Remote Play Together guests.
+ */
+void Initialize();
+
+/// Disconnects from Steam. Call it once the main window is gone.
+void Shutdown();
+
+/**
+ * Remote Play Together for the main window: invites, the guest count in the status bar, guest
+ * keyboards, and a free player for every guest gamepad.
+ */
+class Manager {
+public:
+    explicit Manager(QWidget* parent, InputCommon::InputSubsystem& input_subsystem,
+                     Core::HID::HIDCore& hid_core);
+    ~Manager();
+
+    Manager(const Manager&) = delete;
+    Manager& operator=(const Manager&) = delete;
+
+    /// Adds the invite actions to the end of a menu
+    void AddMenuActions(QMenu* menu);
+
+    /// Status bar label with the guest count, hidden when Steam isn't available
+    [[nodiscard]] QLabel* GetStatusLabel() const;
+
+    /**
+     * Stops handling guests and gives every player handed to a guest its previous configuration
+     * back. Returns true if a player changed, so the configuration needs saving.
+     */
+    bool Close();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+
+} // namespace RemotePlayTogether
