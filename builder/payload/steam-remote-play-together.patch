+void ExtensionManager::SetSetting(Extension& extension, const char* key, const char* value) {
+    if (key == nullptr) {
+        return;
+    }
+    auto& settings = StateEntry(extension.manifest.id).settings;
+    if (value == nullptr) {
+        settings.erase(key);
+    } else {
+        settings.insert_or_assign(key, value);
+    }
+    SaveState();
+}
