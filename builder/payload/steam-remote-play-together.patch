diff --git a/src/input_common/drivers/remote_play_keyboard.cpp b/src/input_common/drivers/remote_play_keyboard.cpp
new file mode 100644
index 0000000..0201722
--- /dev/null
+++ b/src/input_common/drivers/remote_play_keyboard.cpp
@@ -0,0 +1,227 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <utility>
+
+#include <fmt/format.h>
+
+#include "common/param_package.h"
+#include "common/settings_input.h"
+#include "input_common/drivers/remote_play_keyboard.h"
+
+namespace InputCommon {
+
+namespace {
+
+// USB HID usage IDs of the keys used by the default layout
+namespace Usage {
+constexpr int A = 0x04;
+constexpr int C = 0x06;
+constexpr int D = 0x07;
+constexpr int E = 0x08;
+constexpr int F = 0x09;
+constexpr int G = 0x0A;
+constexpr int I = 0x0C;
+constexpr int J = 0x0D;
+constexpr int K = 0x0E;
+constexpr int L = 0x0F;
+constexpr int M = 0x10;
+constexpr int N = 0x11;
+constexpr int Q = 0x14;
+constexpr int R = 0x15;
+constexpr int S = 0x16;
+constexpr int T = 0x17;
+constexpr int V = 0x19;
+constexpr int W = 0x1A;
+constexpr int X = 0x1B;
+constexpr int Z = 0x1D;
+constexpr int Seven = 0x24;
+constexpr int Eight = 0x25;
+constexpr int Right = 0x4F;
+constexpr int Left = 0x50;
+constexpr int Down = 0x51;
+constexpr int Up = 0x52;
+constexpr int LeftShift = 0xE1;
+} // namespace Usage
+
+// Same keys as the default keyboard bindings of the Qt frontend
+constexpr std::array<std::pair<Settings::NativeButton::Values, int>, 20> DefaultButtons{{
+    {Settings::NativeButton::A, Usage::C},
+    {Settings::NativeButton::B, Usage::X},
+    {Settings::NativeButton::X, Usage::V},
+    {Settings::NativeButton::Y, Usage::Z},
+    {Settings::NativeButton::LStick, Usage::F},
+    {Settings::NativeButton::RStick, Usage::G},
+    {Settings::NativeButton::L, Usage::Q},
+    {Settings::NativeButton::R, Usage::E},
+    {Settings::NativeButton::ZL, Usage::R},
+    {Settings::NativeButton::ZR, Usage::T},
+    {Settings::NativeButton::Plus, Usage::M},
+    {Settings::NativeButton::Minus, Usage::N},
+    {Settings::NativeButton::DLeft, Usage::Left},
+    {Settings::NativeButton::DUp, Usage::Up},
+    {Settings::NativeButton::DRight, Usage::Right},
+    {Settings::NativeButton::DDown, Usage::Down},
+    {Settings::NativeButton::SLLeft, Usage::Q},
+    {Settings::NativeButton::SRLeft, Usage::E},
+    {Settings::NativeButton::SLRight, Usage::Q},
+    {Settings::NativeButton::SRRight, Usage::E},
+}};
+
+struct StickKeys {
+    Settings::NativeAnalog::Values stick;
+    int up;
+    int down;
+    int left;
+    int right;
+    int modifier;
+};
+
+constexpr std::array<StickKeys, 2> DefaultSticks{{
+    {Settings::NativeAnalog::LStick, Usage::W, Usage::S, Usage::A, Usage::D, Usage::LeftShift},
+    {Settings::NativeAnalog::RStick, Usage::I, Usage::K, Usage::J, Usage::L, 0},
+}};
+
+constexpr std::array<std::pair<Settings::NativeMotion::Values, int>, 2> DefaultMotions{{
+    {Settings::NativeMotion::MotionLeft, Usage::Seven},
+    {Settings::NativeMotion::MotionRight, Usage::Eight},
+}};
+
+constexpr PadIdentifier GetIdentifier(std::size_t slot) {
+    return {
+        .guid = Common::UUID{},
+        .port = slot,
+        .pad = 0,
+    };
+}
+
+} // Anonymous namespace
+
+RemotePlayKeyboard::RemotePlayKeyboard(std::string input_engine_)
+    : InputEngine(std::move(input_engine_)) {
+    for (std::size_t slot = 0; slot < MaxGuests; ++slot) {
+        PreSetController(GetIdentifier(slot));
+    }
+}
+
+void RemotePlayKeyboard::ConnectGuest(std::size_t slot, std::string name) {
+    if (slot >= MaxGuests) {
+        return;
+    }
+    std::scoped_lock lock{mutex};
+    guest_names[slot] = std::move(name);
+    guest_connected[slot] = true;
+}
+
+void RemotePlayKeyboard::DisconnectGuest(std::size_t slot) {
+    if (slot >= MaxGuests) {
+        return;
+    }
+    std::bitset<MaxUsage> keys;
+    {
+        std::scoped_lock lock{mutex};
+        keys = held_keys[slot];
+        held_keys[slot].reset();
+        guest_names[slot].clear();
+        guest_connected[slot] = false;
+    }
+    for (std::size_t usage = 0; usage < MaxUsage; ++usage) {
+        if (keys.test(usage)) {
+            SetButton(GetIdentifier(slot), static_cast<int>(usage), false);
+        }
+    }
+}
+
+void RemotePlayKeyboard::SetKey(std::size_t slot, int usage, bool pressed) {
+    if (slot >= MaxGuests || usage <= 0 || usage >= static_cast<int>(MaxUsage)) {
+        return;
+    }
+    {
+        std::scoped_lock lock{mutex};
+        if (!guest_connected[slot]) {
+            return;
+        }
+        held_keys[slot].set(static_cast<std::size_t>(usage), pressed);
+    }
+    SetButton(GetIdentifier(slot), usage, pressed);
+}
+
+std::vector<Common::ParamPackage> RemotePlayKeyboard::GetInputDevices() const {
+    std::vector<Common::ParamPackage> devices;
+    std::scoped_lock lock{mutex};
+    for (std::size_t slot = 0; slot < MaxGuests; ++slot) {
+        if (!guest_connected[slot]) {
+            continue;
+        }
+        devices.emplace_back(Common::ParamPackage{
+            {"engine", GetEngineName()},
+            {"display", fmt::format("Remote Play keyboard {} ({})", slot + 1, guest_names[slot])},
+            {"port", std::to_string(slot)},
+        });
+    }
+    return devices;
+}
+
+Common::ParamPackage RemotePlayKeyboard::BuildKeyParam(std::size_t slot, int usage) const {
+    Common::ParamPackage param;
+    param.Set("engine", GetEngineName());
+    param.Set("port", static_cast<int>(slot));
+    param.Set("button", usage);
+    return param;
+}
+
+ButtonMapping RemotePlayKeyboard::GetButtonMappingForDevice(const Common::ParamPackage& params) {
+    if (!params.Has("port")) {
+        return {};
+    }
+    const auto slot = static_cast<std::size_t>(params.Get("port", 0));
+    ButtonMapping mapping;
+    for (const auto& [button, usage] : DefaultButtons) {
+        mapping.insert_or_assign(button, BuildKeyParam(slot, usage));
+    }
+    return mapping;
+}
+
+AnalogMapping RemotePlayKeyboard::GetAnalogMappingForDevice(const Common::ParamPackage& params) {
+    if (!params.Has("port")) {
+        return {};
+    }
+    const auto slot = static_cast<std::size_t>(params.Get("port", 0));
+    AnalogMapping mapping;
+    for (const auto& keys : DefaultSticks) {
+        Common::ParamPackage stick{
+            {"engine", "analog_from_button"},
+            {"up", BuildKeyParam(slot, keys.up).Serialize()},
+            {"down", BuildKeyParam(slot, keys.down).Serialize()},
+            {"left", BuildKeyParam(slot, keys.left).Serialize()},
+            {"right", BuildKeyParam(slot, keys.right).Serialize()},
+        };
+        if (keys.modifier != 0) {
+            stick.Set("modifier", BuildKeyParam(slot, keys.modifier).Serialize());
+            stick.Set("modifier_scale", 0.5f);
+        }
+        mapping.insert_or_assign(keys.stick, std::move(stick));
+    }
+    return mapping;
+}
+
+MotionMapping RemotePlayKeyboard::GetMotionMappingForDevice(const Common::ParamPackage& params) {
+    if (!params.Has("port")) {
+        return {};
+    }
+    const auto slot = static_cast<std::size_t>(params.Get("port", 0));
+    MotionMapping mapping;
+    for (const auto& [motion, usage] : DefaultMotions) {
+        mapping.insert_or_assign(motion, BuildKeyParam(slot, usage));
+    }
+    return mapping;
+}
+
+Common::Input::ButtonNames RemotePlayKeyboard::GetUIName(const Common::ParamPackage& params) const {
+    if (params.Has("button")) {
+        return Common::Input::ButtonNames::Value;
+    }
+    return Common::Input::ButtonNames::Invalid;
+}
+
+} // namespace InputCommon
diff --git a/src/input_common/drivers/remote_play_keyboard.h b/src/input_common/drivers/remote_play_keyboard.h
new file mode 100644
index 0000000..f125ea3
--- /dev/null
+++ b/src/input_common/drivers/remote_play_keyboard.h
@@ -0,0 +1,51 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <bitset>
+#include <mutex>
+#include <string>
+
+#include "input_common/input_engine.h"
+
+namespace InputCommon {
+
+/**
+ * Keyboards of remote players, such as Steam Remote Play Together guests. Each guest slot is a
+ * separate device. Keys are USB HID usage IDs from the Keyboard/Keypad page (0x07).
+ */
+class RemotePlayKeyboard final : public InputEngine {
+public:
+    static constexpr std::size_t MaxGuests = 8;
+
+    explicit RemotePlayKeyboard(std::string input_engine_);
+
+    /// Lists the keyboard of the guest in this slot as an input device
+    void ConnectGuest(std::size_t slot, std::string name);
+
+    /// Releases every key the guest is holding and removes the device
+    void DisconnectGuest(std::size_t slot);
+
+    /// Sets the state of a key of the guest in this slot
+    void SetKey(std::size_t slot, int usage, bool pressed);
+
+    std::vector<Common::ParamPackage> GetInputDevices() const override;
+    ButtonMapping GetButtonMappingForDevice(const Common::ParamPackage& params) override;
+    AnalogMapping GetAnalogMappingForDevice(const Common::ParamPackage& params) override;
+    MotionMapping GetMotionMappingForDevice(const Common::ParamPackage& params) override;
+    Common::Input::ButtonNames GetUIName(const Common::ParamPackage& params) const override;
+
+private:
+    static constexpr std::size_t MaxUsage = 256;
+
+    Common::ParamPackage BuildKeyParam(std::size_t slot, int usage) const;
+
+    mutable std::mutex mutex;
+    std::array<std::string, MaxGuests> guest_names{};
+    std::array<bool, MaxGuests> guest_connected{};
+    std::array<std::bitset<MaxUsage>, MaxGuests> held_keys{};
+};
+
+} // namespace InputCommon
