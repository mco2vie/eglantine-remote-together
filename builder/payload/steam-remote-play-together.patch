diff --git a/CMakeModules/find/FindSteamworks.cmake b/CMakeModules/find/FindSteamworks.cmake
new file mode 100644
index 0000000..6d0a804
--- /dev/null
+++ b/CMakeModules/find/FindSteamworks.cmake
@@ -0,0 +1,69 @@
+# SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# Finds the Steamworks SDK in STEAMWORKS_SDK_DIR, the "sdk" folder of the SDK download.
+# Valve's license only allows redistributing redistributable_bin, so the SDK is never fetched or
+# vendored; every developer downloads it from https://partner.steamgames.com/.
+#
+# Provides Steamworks::steam_api and Steamworks_RUNTIME, the library to copy next to the program.
+
+set(STEAMWORKS_SDK_DIR "" CACHE PATH "The sdk folder of the Steamworks SDK (1.62 or newer)")
+
+if (WIN32)
+    set(_steamworks_bin "${STEAMWORKS_SDK_DIR}/redistributable_bin/win64")
+    set(_steamworks_name steam_api64)
+elseif (APPLE)
+    set(_steamworks_bin "${STEAMWORKS_SDK_DIR}/redistributable_bin/osx")
+    set(_steamworks_name steam_api)
+elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+    set(_steamworks_bin "${STEAMWORKS_SDK_DIR}/redistributable_bin/linuxarm64")
+    set(_steamworks_name steam_api)
+else()
+    set(_steamworks_bin "${STEAMWORKS_SDK_DIR}/redistributable_bin/linux64")
+    set(_steamworks_name steam_api)
+endif()
+
+find_path(Steamworks_INCLUDE_DIR steam/steam_api.h
+    HINTS "${STEAMWORKS_SDK_DIR}/public" NO_DEFAULT_PATH)
+find_library(Steamworks_LIBRARY ${_steamworks_name} HINTS "${_steamworks_bin}" NO_DEFAULT_PATH)
+if (WIN32)
+    find_file(Steamworks_RUNTIME ${_steamworks_name}.dll HINTS "${_steamworks_bin}" NO_DEFAULT_PATH)
+else()
+    set(Steamworks_RUNTIME "${Steamworks_LIBRARY}")
+endif()
+
+# The Remote Play Together input API arrived in SDK 1.62
+set(Steamworks_HAS_REMOTE_PLAY_INPUT FALSE)
+if (Steamworks_INCLUDE_DIR AND EXISTS "${Steamworks_INCLUDE_DIR}/steam/isteamremoteplay.h")
+    file(STRINGS "${Steamworks_INCLUDE_DIR}/steam/isteamremoteplay.h" _steamworks_direct_input
+        REGEX "BEnableRemotePlayTogetherDirectInput")
+    if (_steamworks_direct_input)
+        set(Steamworks_HAS_REMOTE_PLAY_INPUT TRUE)
+    endif()
+endif()
+
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(Steamworks
+    REQUIRED_VARS
+        Steamworks_LIBRARY
+        Steamworks_RUNTIME
+        Steamworks_INCLUDE_DIR
+        Steamworks_HAS_REMOTE_PLAY_INPUT
+    REASON_FAILURE_MESSAGE
+        "Set STEAMWORKS_SDK_DIR to the sdk folder of the Steamworks SDK, version 1.62 or newer")
+
+if (Steamworks_FOUND AND NOT TARGET Steamworks::steam_api)
+    add_library(Steamworks::steam_api SHARED IMPORTED)
+    set_target_properties(Steamworks::steam_api PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${Steamworks_INCLUDE_DIR}")
+    if (WIN32)
+        set_target_properties(Steamworks::steam_api PROPERTIES
+            IMPORTED_LOCATION "${Steamworks_RUNTIME}"
+            IMPORTED_IMPLIB "${Steamworks_LIBRARY}")
+    else()
+        set_target_properties(Steamworks::steam_api PROPERTIES
+            IMPORTED_LOCATION "${Steamworks_LIBRARY}")
+    endif()
+endif()
+
+mark_as_advanced(Steamworks_INCLUDE_DIR Steamworks_LIBRARY Steamworks_RUNTIME)
